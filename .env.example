YPC_DEBUG=true
YPC_SECRET_KEY=replace-with-a-long-random-secret
YPC_ALLOWED_HOSTS=localhost,127.0.0.1
YPC_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
YPC_DATA_DIR=.
# SMTP is optional locally. Console messages are not delivered emails.
YPC_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
YPC_EMAIL_HOST=
YPC_EMAIL_PORT=587
YPC_EMAIL_HOST_USER=
YPC_EMAIL_HOST_PASSWORD=
YPC_EMAIL_USE_TLS=true
YPC_DEFAULT_FROM_EMAIL=Your Pet Care <care@example.com>
# Identify your independent deployment to OpenStreetMap services.
YPC_OSM_USER_AGENT=YourPetCare-local-development/1.0
YPC_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
YPC_OVERPASS_URL=https://overpass-api.de/api/interpreter
YPC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Passwordless isolated browser workspaces; loopback only. Disable for hosting.
YPC_LOCAL_PREVIEW=false

# Optional same-network phone preview; keep empty/loopback for normal local use.
YPC_LOCAL_BIND=127.0.0.1
YPC_PREVIEW_NETWORKS=
