HOST=127.0.0.1
PORT=3060
YPC_MONGODB_URI=
YPC_MONGODB_DATABASE=yourpetcare
YPC_OPENAI_API_KEY=
YPC_COMPANION_MODEL=gpt-6-sol
YPC_WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Optional: existing staff login verification endpoint, set privately on EC2.
YPC_ADMIN_PROFILE_URL=
# Generate privately on the server: 32 random bytes encoded as 64 hex characters.
# Encrypts keys saved through admin; do not rotate without re-saving that key.
YPC_KEY_ENCRYPTION_KEY=
YPC_TRANSCRIPTION_MODEL=gpt-transcribe
# Opt-in on the MPCV2 test backend before production rollout.
YPC_PIP_AGENT_V2=0
# Metadata-only diagnostics; ignored when NODE_ENV=production.
YPC_AGENT_DEBUG=0
